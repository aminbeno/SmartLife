<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartLife" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main Design System Colors -->
        <!-- Primary: Energetic Indigo -->
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>

        <!-- Secondary: Vibrant Cyan -->
        <item name="colorSecondary">@color/secondary_color</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/secondary_light</item>
        <item name="colorOnSecondaryContainer">@color/secondary_dark</item>

        <!-- Tertiary: Warm Amber -->
        <item name="colorTertiary">@color/tertiary_color</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/tertiary_light</item>
        <item name="colorOnTertiaryContainer">@color/tertiary_dark</item>

        <!-- Backgrounds and Surfaces -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_color</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="colorSurfaceVariant">@color/outline_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline_variant</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.SmartLife" parent="Base.Theme.SmartLife" />
</resources>